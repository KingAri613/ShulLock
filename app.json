{
  "expo": {
    "name": "Shul Lock",
    "slug": "shul-lock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "owner": "iv.sites",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shullock.app",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Shul Lock needs your location to detect when you enter or leave a shul so it can automatically silence your phone.",
        "NSLocationWhenInUseUsageDescription": "Shul Lock needs your location to detect when you are near a shul.",
        "NSLocationAlwaysUsageDescription": "Shul Lock needs background location access to automatically silence your phone when you arrive at a shul, even when the app is closed.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A237E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.shullock.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Shul Lock needs your location to detect when you enter or leave a shul.",
          "locationAlwaysPermission": "Shul Lock needs background location to auto-silence when you arrive at a shul.",
          "locationWhenInUsePermission": "Shul Lock needs your location to detect nearby shuls.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A237E"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "62b934a7-3a52-4b02-9df0-2039d1ab21bf"
      }
    }
  }
}
